VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Integration 1 — OneDrive Order Config XLSX sync
VITE_ONEDRIVE_CLIENT_ID=
VITE_ONEDRIVE_TENANT_ID=
VITE_ONEDRIVE_FILE_ITEM_ID=

# Integration 2 — monday.com Location List sync now runs entirely
# server-side via the monday-sync-locations Edge Function + the Data
# Connections page — the token is a Supabase secret (MONDAY_API_KEY, set
# via `supabase secrets set`), never a client env var. No VITE_MONDAY_*
# variables are needed or read anymore.

# Integration 3 — Droptop Month End API pull
VITE_DROPTOP_API_KEY=
VITE_DROPTOP_BASE_URL=https://droptop-app.com
